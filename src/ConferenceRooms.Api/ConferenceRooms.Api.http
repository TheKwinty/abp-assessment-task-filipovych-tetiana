@ConferenceRoomsApi_HostAddress = https://localhost:7284
@hallAId = 11111111-1111-1111-1111-111111111111
@unknownHallId = 99999999-9999-9999-9999-999999999999

# Replace this value with the Hall ID returned by the POST request.
@createdHallId = 00000000-0000-0000-0000-000000000000

### List halls
# Expected: 200 OK
GET {{ConferenceRoomsApi_HostAddress}}/api/halls
Accept: application/json

### Get seeded Hall A
# Expected: 200 OK
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/{{hallAId}}
Accept: application/json

### Get an unknown Hall
# Expected: 404 Not Found
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/{{unknownHallId}}
Accept: application/json

### Create a Hall
# Expected: 201 Created. Copy the returned ID into @createdHallId above.
POST {{ConferenceRoomsApi_HostAddress}}/api/halls
Content-Type: application/json
Accept: application/json

{
  "name": "Manual Test Hall",
  "capacity": 25,
  "baseHourlyRate": 1200.00,
  "services": [
    {
      "name": "Projector",
      "price": 450.00
    },
    {
      "name": "Coffee service",
      "price": 250.00
    }
  ]
}

### Get the created Hall
# Expected: 200 OK after replacing @createdHallId with the POST response ID.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/{{createdHallId}}
Accept: application/json

###############################################################################
# Hall availability API
###############################################################################

### Search availability for 20 attendees
# Expected with no Bookings: 200 OK; Hall C, Hall A, Hall B.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T10:00:00%2B03:00&durationHours=2&capacity=20
Accept: application/json

### Search availability for 40 attendees
# Expected with no Bookings: 200 OK; Hall A, Hall B.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T10:00:00%2B03:00&durationHours=2&capacity=40
Accept: application/json

### Search availability for 60 attendees
# Expected with no Bookings: 200 OK; Hall B.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T10:00:00%2B03:00&durationHours=2&capacity=60
Accept: application/json

### Search availability above every Hall capacity
# Expected: 200 OK with [].
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T10:00:00%2B03:00&durationHours=2&capacity=101
Accept: application/json

### Search with a past start
# Expected: 400 Bad Request.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2024-10-01T10:00:00%2B03:00&durationHours=2&capacity=40
Accept: application/json

### Search from a half-hour boundary
# Expected with no Bookings: 200 OK; Hall A, Hall B.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T10:30:00%2B03:00&durationHours=2&capacity=40
Accept: application/json

### Search outside a 30-minute boundary
# Expected: 400 Bad Request.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T10:15:00%2B03:00&durationHours=2&capacity=40
Accept: application/json

### Search before opening time
# Expected: 400 Bad Request.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T05:00:00%2B03:00&durationHours=1&capacity=40
Accept: application/json

### Search ending after closing time
# Expected: 400 Bad Request.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T22:00:00%2B03:00&durationHours=2&capacity=40
Accept: application/json

### Search ending exactly at closing time
# Expected: 200 OK.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T22:00:00%2B03:00&durationHours=1&capacity=40
Accept: application/json

### Search from 22:30 for one hour
# Expected: 400 Bad Request because the interval ends after closing time.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T22:30:00%2B03:00&durationHours=1&capacity=40
Accept: application/json

### Search with zero duration
# Expected: 400 Bad Request.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T10:00:00%2B03:00&durationHours=0&capacity=40
Accept: application/json

### Search with zero capacity
# Expected: 400 Bad Request.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T10:00:00%2B03:00&durationHours=2&capacity=0
Accept: application/json

### Search missing required capacity
# Expected: 400 Bad Request.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T10:00:00%2B03:00&durationHours=2
Accept: application/json

### Search overlapping a temporary Hall A booking from 10:30 to 12:30
# Expected after creating that Booking: 200 OK; Hall A excluded, Hall B remains.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T11:00:00%2B03:00&durationHours=1&capacity=40
Accept: application/json

### Search at the end boundary of a temporary Hall A booking from 10:30 to 12:30
# Expected after creating that Booking: 200 OK; Hall A and Hall B included.
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/available?start=2030-10-01T12:30:00%2B03:00&durationHours=1&capacity=40
Accept: application/json

###############################################################################
# Booking API
###############################################################################

@hallBId = 22222222-2222-2222-2222-222222222222
@hallCId = 33333333-3333-3333-3333-333333333333
@hallAProjectorId = a0000000-0000-0000-0000-000000000001
@hallAWiFiId = a0000000-0000-0000-0000-000000000002
@hallBWiFiId = b0000000-0000-0000-0000-000000000002
@unknownServiceOfferingId = ffffffff-ffff-ffff-ffff-ffffffffffff

# Replace this value with a Booking ID returned by a successful POST request.
@createdBookingId = 00000000-0000-0000-0000-000000000000

### Create a booking without services
# Expected: 201 Created with start 10:30, end 12:30, and total price 4150.00.
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2030-09-05T10:30:00+03:00",
  "durationHours": 2,
  "attendeeCount": 40,
  "serviceOfferingIds": []
}

### Create a booking with services
# Expected: 201 Created. Copy the returned ID into @createdBookingId above.
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2030-09-05T14:00:00+03:00",
  "durationHours": 2,
  "attendeeCount": 40,
  "serviceOfferingIds": [
    "{{hallAProjectorId}}",
    "{{hallAWiFiId}}"
  ]
}

### Get the created booking confirmation
# Expected: 200 OK after replacing @createdBookingId.
GET {{ConferenceRoomsApi_HostAddress}}/api/bookings/{{createdBookingId}}
Accept: application/json

### Create a booking for a nonexistent Hall
# Expected: 404 Not Found
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{unknownHallId}}",
  "start": "2030-09-05T10:00:00+03:00",
  "durationHours": 2,
  "attendeeCount": 10,
  "serviceOfferingIds": []
}

### Submit zero attendees
# Expected: 400 Bad Request
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2030-09-06T10:00:00+03:00",
  "durationHours": 2,
  "attendeeCount": 0,
  "serviceOfferingIds": []
}

### Submit an empty Hall ID
# Expected: 400 Bad Request
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "00000000-0000-0000-0000-000000000000",
  "start": "2030-09-06T10:00:00+03:00",
  "durationHours": 2,
  "attendeeCount": 40,
  "serviceOfferingIds": []
}

### Exceed Hall capacity
# Expected: 400 Bad Request
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2030-09-06T10:00:00+03:00",
  "durationHours": 2,
  "attendeeCount": 51,
  "serviceOfferingIds": []
}

### Submit a past booking
# Expected: 400 Bad Request
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2024-09-05T10:00:00+03:00",
  "durationHours": 2,
  "attendeeCount": 40,
  "serviceOfferingIds": []
}

### Submit a booking outside a 30-minute boundary
# Expected: 400 Bad Request
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2030-09-06T10:15:00+03:00",
  "durationHours": 2,
  "attendeeCount": 40,
  "serviceOfferingIds": []
}

### Submit a booking before opening time
# Expected: 400 Bad Request
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2030-09-06T05:00:00+03:00",
  "durationHours": 2,
  "attendeeCount": 40,
  "serviceOfferingIds": []
}

### Submit a booking that crosses midnight
# Expected: 400 Bad Request
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2030-09-06T22:00:00+03:00",
  "durationHours": 2,
  "attendeeCount": 40,
  "serviceOfferingIds": []
}

### Submit a 22:30 booking that ends after closing time
# Expected: 400 Bad Request
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallCId}}",
  "start": "2030-09-06T22:30:00+03:00",
  "durationHours": 1,
  "attendeeCount": 20,
  "serviceOfferingIds": []
}

### Submit duplicate service IDs
# Expected: 400 Bad Request
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2030-09-06T10:00:00+03:00",
  "durationHours": 2,
  "attendeeCount": 40,
  "serviceOfferingIds": [
    "{{hallAProjectorId}}",
    "{{hallAProjectorId}}"
  ]
}

### Submit an unknown service ID
# Expected: 400 Bad Request
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2030-09-06T10:00:00+03:00",
  "durationHours": 2,
  "attendeeCount": 40,
  "serviceOfferingIds": [
    "{{unknownServiceOfferingId}}"
  ]
}

### Submit a service belonging to another Hall
# Expected: 400 Bad Request
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2030-09-06T10:00:00+03:00",
  "durationHours": 2,
  "attendeeCount": 40,
  "serviceOfferingIds": [
    "{{hallBWiFiId}}"
  ]
}

### Submit a booking that overlaps 10:30-12:30
# Expected: 409 Conflict after creating the first booking example.
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2030-09-05T11:00:00+03:00",
  "durationHours": 2,
  "attendeeCount": 40,
  "serviceOfferingIds": []
}

### Start exactly when the 10:30-12:30 booking ends
# Expected: 201 Created because booking intervals use [start, end).
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallAId}}",
  "start": "2030-09-05T12:30:00+03:00",
  "durationHours": 2,
  "attendeeCount": 40,
  "serviceOfferingIds": []
}

### End exactly at closing time
# Expected: 201 Created
POST {{ConferenceRoomsApi_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "hallId": "{{hallCId}}",
  "start": "2030-09-05T22:00:00+03:00",
  "durationHours": 1,
  "attendeeCount": 20,
  "serviceOfferingIds": []
}

### Delete a Hall that has a booking
# Expected: 409 Conflict after creating a Hall A booking.
DELETE {{ConferenceRoomsApi_HostAddress}}/api/halls/{{hallAId}}

### Replace the created Hall details and services
# Expected: 204 No Content
PUT {{ConferenceRoomsApi_HostAddress}}/api/halls/{{createdHallId}}
Content-Type: application/json

{
  "name": "Manual Test Hall Updated",
  "capacity": 35,
  "baseHourlyRate": 1500.00,
  "services": [
    {
      "name": "Sound",
      "price": 600.00
    }
  ]
}

### Get the updated Hall
# Expected: 200 OK with the updated state
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/{{createdHallId}}
Accept: application/json

### Submit an invalid Hall
# Expected: 400 Bad Request
POST {{ConferenceRoomsApi_HostAddress}}/api/halls
Content-Type: application/json
Accept: application/json

{
  "name": "   ",
  "capacity": 0,
  "baseHourlyRate": 10.123,
  "services": null
}

### Delete the created Hall
# Expected: 204 No Content
DELETE {{ConferenceRoomsApi_HostAddress}}/api/halls/{{createdHallId}}

### Confirm the created Hall was deleted
# Expected: 404 Not Found
GET {{ConferenceRoomsApi_HostAddress}}/api/halls/{{createdHallId}}
Accept: application/json
