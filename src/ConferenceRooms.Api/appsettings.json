{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ConferenceRoomsDb;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "RequestLimits": {
    "MaxRequestBodySizeBytes": 65536
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
